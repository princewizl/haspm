<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title>Sign In | HS Property</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet"/>
  <style>
    :root {
      --cr: #C9184A;
      --cr-d: #9E1239;
      --nv: #0D3A6B;
      --wh: #fff;
      --text: #111827;
      --text-muted: #6B7280;
      --border: #D1D5DB;
      --bg: #F9FAFB;
      --bg-input: #ffffff;
    }
    
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    
    html, body {
      min-height: 100vh;
      font-family: 'Aptos', 'Segoe UI', system-ui, -apple-system, sans-serif;
      background: #ffffff;
      color: var(--text);
      overflow-x: hidden;
      letter-spacing: 0.015em;
    }

    .root {
      display: grid;
      grid-template-columns: 1fr 1fr;
      min-height: 100vh;
    }

    /* ── LEFT PANEL ── */
    .left {
      background: #ffffff;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 60px 54px;
      border-right: 1px solid var(--border);
    }

    .brand-img {
      width: 100%;
      max-width: 620px; /* Made the logo very large */
      height: auto;
    }

    /* ── RIGHT PANEL ── */
    .right {
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 40px;
      background: #f3f4f6;
    }

    .card {
      width: 100%;
      max-width: 440px;
      background: #ffffff;
      padding: 48px;
      border-radius: 16px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);
      border: 1px solid rgba(0, 0, 0, 0.03);
    }

    .ch { margin-bottom: 32px; }
    .ch h2 {
      font-weight: 800;
      font-size: 26px;
      color: var(--text);
      margin-bottom: 8px;
      letter-spacing: -0.01em;
    }
    .ch p { 
      color: var(--text-muted); 
      font-size: 15px; 
      word-spacing: 0.05em;
    }

    .fg { margin-bottom: 22px; }
    .fl {
      display: block;
      font-size: 13px;
      font-weight: 600;
      color: var(--text);
      margin-bottom: 8px;
      letter-spacing: 0.03em;
    }
    .fw { position: relative; }
    .fi {
      position: absolute;
      left: 14px; top: 50%;
      transform: translateY(-50%);
      color: var(--text-muted);
      font-size: 16px;
      pointer-events: none;
    }
    .ff {
      width: 100%;
      background: var(--bg-input);
      border: 1.5px solid var(--border);
      border-radius: 10px;
      padding: 12px 42px 12px 42px;
      color: var(--text);
      font-size: 15px;
      outline: none;
      font-family: inherit;
      transition: border-color .2s, box-shadow .2s;
    }
    .ff::placeholder { color: #9CA3AF; }
    .ff:focus {
      border-color: var(--cr);
      box-shadow: 0 0 0 3px rgba(201,24,74,.1);
    }
    .ptog {
      position: absolute;
      right: 12px; top: 50%;
      transform: translateY(-50%);
      background: none; border: none;
      color: var(--text-muted);
      cursor: pointer;
      font-size: 16px;
      padding: 4px;
    }
    .ptog:hover { color: var(--text); }

    .frow { display: flex; justify-content: flex-end; margin: -4px 0 24px; }
    .fl2 { font-size: 13px; color: var(--cr); text-decoration: none; font-weight: 500; }
    .fl2:hover { text-decoration: underline; }

    .bsub {
      width: 100%;
      padding: 14px;
      border: none;
      border-radius: 10px;
      background: var(--cr);
      color: #fff;
      font-family: inherit;
      font-size: 16px;
      font-weight: 700;
      cursor: pointer;
      display: flex; align-items: center; justify-content: center; gap: 8px;
      transition: background .2s, transform .1s;
      letter-spacing: 0.02em;
    }
    .bsub:hover { background: var(--cr-d); }
    .bsub:active { transform: scale(0.98); }

    .aerr {
      background: #FEF2F2;
      border: 1px solid #FECACA;
      border-radius: 9px;
      padding: 12px 14px;
      margin-bottom: 20px;
      display: flex; align-items: center; gap: 10px;
      color: #B91C1C;
      font-size: 14px;
    }
    .ainfo {
      background: #EFF6FF;
      border: 1px solid #BFDBFE;
      border-radius: 9px;
      padding: 12px 14px;
      margin-bottom: 20px;
      display: flex; align-items: center; gap: 10px;
      color: #1D4ED8;
      font-size: 14px;
    }

    .foot {
      text-align: center;
      margin-top: 24px;
      font-size: 12px;
      color: var(--text-muted);
      letter-spacing: 0.02em;
    }
    .foot span { color: var(--cr); font-weight: 600; }

    /* ── RESPONSIVE ── */
    @media (max-width: 900px) {
      .root { display: flex; flex-direction: column; }
      .left {
        padding: 44px 28px 32px;
        border-right: none;
        border-bottom: 1px solid var(--border);
      }
      .brand-img { max-width: 280px; }
      .right { padding: 36px 20px 52px; background: #ffffff; }
      .card { box-shadow: none; border: none; padding: 20px; }
    }

    @media (max-width: 480px) {
      .brand-img { max-width: 220px; }
      .card { max-width: 100%; padding: 10px; }
    }
  </style>
</head>
<body>
<div class="root">

  <div class="left">
    <img src="/static/img/hslogo1.jpeg" alt="Hearts & Sleeves Logo" class="brand-img" />
  </div>

  <div class="right">
    <div class="card">
      <div class="ch">
        <h2>Welcome back</h2>
        <p>Sign in to access your dashboard</p>
      </div>

      {% with messages = get_flashed_messages(with_categories=true) %}
        {% for cat, msg in messages %}
          <div class="{{ 'aerr' if cat=='danger' else 'ainfo' }}">
            <i class="bi bi-{{ 'exclamation-circle-fill' if cat=='danger' else 'info-circle-fill' }}"></i> {{ msg }}
          </div>
        {% endfor %}
      {% endwith %}

      <form method="POST" action="{{ url_for('login') }}" id="lf">
        <div class="fg">
          <label class="fl">Email Address</label>
          <div class="fw">
            <i class="bi bi-envelope fi"></i>
            <input class="ff" type="email" name="email" placeholder="you@example.com" required autocomplete="email"/>
          </div>
        </div>
        <div class="fg">
          <label class="fl">Password</label>
          <div class="fw">
            <i class="bi bi-lock fi"></i>
            <input class="ff" type="password" name="password" id="pf" placeholder="Enter your password" required/>
            <button type="button" class="ptog" onclick="toggleP()"><i class="bi bi-eye" id="pi"></i></button>
          </div>
        </div>
        <div class="frow"><a href="#" class="fl2">Forgot password?</a></div>
        <button type="submit" class="bsub" id="sb">Sign In &rarr;</button>
      </form>
      <div class="foot">Secured by <span>HS Property</span> &middot; SSL Encrypted</div>
    </div>
  </div>

</div>
<script>
function toggleP() {
  const f = document.getElementById('pf'), i = document.getElementById('pi');
  f.type = f.type === 'password' ? 'text' : 'password';
  i.className = f.type === 'password' ? 'bi bi-eye' : 'bi bi-eye-slash';
}
function fill(e, p) {
  document.querySelector('input[name="email"]').value = e;
  document.getElementById('pf').value = p;
}
</script>
</body>
</html>
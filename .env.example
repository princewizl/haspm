# Copy to .env.live and .env.test on the server (bootstrap-server.sh does this
# for you and generates a real SECRET_KEY). Never commit the real files.

# live | test | development — drives the environment banner
APP_ENV=live

# Flask session signing key. Generate with: openssl rand -hex 32
# Changing it logs everyone out.
SECRET_KEY=change-me

# Optional overrides — the compose file already sets these per environment.
# HSPM_DATA_DIR=/app/data
# DOCS_UPLOAD_FOLDER=/app/uploads/documents
# ENABLE_SCHEDULER=0
# MAIL_SUPPRESS_SEND=1

# SMTP and Paystack are configured in-app (Settings) and persisted to
# /app/data/email_config.json and /app/data/paystack_config.json.
